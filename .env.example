# Stripe Configuration (Required)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_WEBHOOK_SECRET_RECORDING=whsec_your_recording_webhook_secret_here

# Agora (livestreaming). The App ID is public — it ships to the browser in the
# token response. The App Certificate is the secret that signs channel tokens,
# and with it the server decides who may publish; it must never reach the
# frontend or the repo. Enable it under Primary Certificate in the Agora
# console, otherwise tokens are ignored and any viewer can publish.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_primary_certificate_here

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URLs (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGIN=https://your-custom-domain.com
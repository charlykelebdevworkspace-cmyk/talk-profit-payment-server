# Stripe Configuration (Required)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_WEBHOOK_SECRET_RECORDING=whsec_your_recording_webhook_secret_here

# Signing secret for the endpoint delivering payment_intent.succeeded, which is
# how a credit top-up is granted when the buyer closes the tab before the
# inline confirmation runs. /stripe/webhook tries every secret it holds, so
# this may be a second Stripe endpoint or the same one with the event added.
STRIPE_WEBHOOK_SECRET_TOPUP=whsec_your_topup_webhook_secret_here

# Shared secret proving this server to the credit-topup Edge Function, which
# holds the service-role key this server cannot have. Must be identical here
# and in that function's secrets. Without it, cards are charged and no credits
# are granted.
TOPUP_BRIDGE_SECRET=generate_a_long_random_string

# Agora (livestreaming). The App ID is public — it ships to the browser in the
# token response. The App Certificate is the secret that signs channel tokens,
# and with it the server decides who may publish; it must never reach the
# frontend or the repo. Enable it under Primary Certificate in the Agora
# console, otherwise tokens are ignored and any viewer can publish.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_primary_certificate_here

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URLs (for CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app
ALLOWED_ORIGIN=https://your-custom-domain.com